    "import cv2\n",
    "import torch\n",
    "import openai\n",
    "import numpy as np\n",
    "from flask import Flask, request, jsonify\n",
    "from flask_cors import CORS\n",
    "from ultralytics import YOLO\n",
    "from flask_sqlalchemy import SQLAlchemy\n",
    "from flask_bcrypt import Bcrypt\n",
    "from flask_jwt_extended import JWTManager, create_access_token, jwt_required, get_jwt_identity\n",
    "import datetime\n",
    "\n",
    "# إعداد التطبيق\n",
    "app = Flask(__name__)\n",
    "CORS(app)\n",
    "\n",
    "# تحميل نموذج YOLO\n",
    "MODEL_PATH = r\"C:\\Users\\Abdo\\Downloads\\best.pt\"\n",
    "model = YOLO(MODEL_PATH)\n",
    "\n",
    "# 🔐 إعداد مفتاح OpenAI API - حط الـ API key بتاعك هنا\n",
    "openai.api_key = \"\"\n",
    "\n",
    "# إعداد قاعدة البيانات\n",
    "app.config[\"SQLALCHEMY_DATABASE_URI\"] = \"sqlite:///dental_diagnosis.db\"\n",
    "app.config[\"SQLALCHEMY_TRACK_MODIFICATIONS\"] = False\n",
    "app.config[\"JWT_SECRET_KEY\"] = \"super-secret-key\"\n",
    "\n",
    "db = SQLAlchemy(app)\n",
    "bcrypt = Bcrypt(app)\n",
    "jwt = JWTManager(app)\n",
    "\n",
    "# تعريف الجداول في قاعدة البيانات\n",
    "class User(db.Model):\n",
    "    id = db.Column(db.Integer, primary_key=True)\n",
    "    username = db.Column(db.String(50), unique=True, nullable=False)\n",
    "    password = db.Column(db.String(100), nullable=False)\n",
    "\n",
    "class Diagnosis(db.Model):\n",
    "    id = db.Column(db.Integer, primary_key=True)\n",
    "    user_id = db.Column(db.Integer, db.ForeignKey(\"user.id\"), nullable=False)\n",
    "    image_path = db.Column(db.String(200), nullable=False)\n",
    "    disease = db.Column(db.String(50), nullable=False)\n",
    "    confidence = db.Column(db.Float, nullable=False)\n",
    "    timestamp = db.Column(db.DateTime, default=datetime.datetime.utcnow)\n",
    "\n",
    "# إنشاء الجداول\n",
    "with app.app_context():\n",
    "    db.create_all()\n",
    "\n",
    "# خريطة الأمراض ونصائح الوقاية\n",
    "CLASS_MAPPING = {\n",
    "    0: \"Cavity\",\n",
    "    1: \"Impacted Tooth\",\n",
    "    2: \"Filling\",\n",
    "    3: \"Implant\"\n",
    "}\n",
    "\n",
    "PREVENTION_TIPS = {\n",
    "    \"Cavity\": \"قم بتنظيف أسنانك بالفرشاة مرتين يوميًا، وتجنب السكريات الزائدة.\",\n",
    "    \"Impacted Tooth\": \"راجع طبيب الأسنان إذا شعرت بألم أو تورم، وقد تحتاج إلى جراحة.\",\n",
    "    \"Filling\": \"حافظ على نظافة الفم، وتجنب الطعام القاسي حتى يلتئم الحشو.\",\n",
    "    \"Implant\": \"اغسل فمك بغسول مضاد للبكتيريا، وابتعد عن التدخين للحفاظ على الزرعة.\"\n",
    "}\n",
    "\n",
    "@app.route(\"/\")\n",
    "def home():\n",
    "    return \"🚀 API تعمل بنجاح!\"\n",
    "\n",
    "@app.route(\"/predict\", methods=[\"POST\"])\n",
    "def predict():\n",
    "    if \"image\" not in request.files:\n",
    "        return jsonify({\"error\": \"يرجى رفع صورة\"}), 400\n",
    "\n",
    "    image_file = request.files[\"image\"]\n",
    "    file_bytes = np.frombuffer(image_file.read(), np.uint8)\n",
    "\n",
    "    if file_bytes.size == 0:\n",
    "        return jsonify({\"error\": \"فشل تحميل الصورة\"}), 400\n",
    "\n",
    "    image = cv2.imdecode(file_bytes, cv2.IMREAD_COLOR)\n",
    "    if image is None:\n",
    "        return jsonify({\"error\": \"صورة غير صالحة\"}), 400\n",
    "\n",
    "    results = model(image)\n",
    "    detections = []\n",
    "    detected_diseases = set()\n",
    "\n",
    "    for result in results:\n",
    "        for box in result.boxes.data:\n",
    "            x1, y1, x2, y2, score, class_id = box.tolist()\n",
    "            disease_name = CLASS_MAPPING.get(int(class_id), \"Unknown\")\n",
    "            tip = PREVENTION_TIPS.get(disease_name, \"No advice available\")\n",
    "\n",
    "            if score >= 0.3 and disease_name not in detected_diseases:\n",
    "                detected_diseases.add(disease_name)\n",
    "                detections.append({\n",
    "                    \"x1\": int(x1), \"y1\": int(y1), \"x2\": int(x2), \"y2\": int(y2),\n",
    "                    \"score\": round(score, 2),\n",
    "                    \"disease\": disease_name,\n",
    "                    \"prevention_tip\": tip\n",
    "                })\n",
    "\n",
    "    return jsonify({\"detections\": detections})\n",
    "\n",
    "@app.route(\"/chat\", methods=[\"POST\"])\n",
    "def chat():\n",
    "    data = request.get_json()\n",
    "    user_message = data.get(\"message\", \"\").strip()\n",
    "\n",
    "    if not user_message:\n",
    "        return jsonify({\"response\": \"❌ لم يتم إرسال أي رسالة.\"}), 400\n",
    "\n",
    "    try:\n",
    "        # ✅ استخدم gpt-3.5-turbo بدل gpt-4 لتوفير التكلفة\n",
    "        response = openai.ChatCompletion.create(\n",
    "            model=\"gpt-3.5-turbo\",\n",
    "            messages=[\n",
    "                {\"role\": \"system\", \"content\": \"أنت مساعد طبي متخصص في أمراض الأسنان، أجب بشكل دقيق وباللغة العربية الفصحى.\"},\n",
    "                {\"role\": \"user\", \"content\": user_message}\n",
    "            ]\n",
    "        )\n",
    "        bot_response = response[\"choices\"][0][\"message\"][\"content\"]\n",
    "        return jsonify({\"response\": bot_response})\n",
    "\n",
    "    except Exception as e:\n",
    "        return jsonify({\"response\": \"⚠️ حدث خطأ أثناء الاتصال بـ OpenAI\", \"error\": str(e)}), 500\n",
    "\n",
    "# تشغيل التطبيق\n",
    "if __name__ == \"__main__\":\n",
    "    app.run(host=\"0.0.0.0\", port=5001)\n"
   ]
  },
